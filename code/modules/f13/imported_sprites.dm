/obj/structure/imported/crate_breakable
	name = "crate"
	desc = "A sealed crate. You'll have to break it open to see what's inside."
	icon = 'code/modules/f13/crates.dmi'
	density = TRUE
	anchored = FALSE
	max_integrity = 50
	var/material_drop = /obj/item/stack/sheet/mineral/wood
	var/material_drop_amount = 2
	var/break_sound = 'sound/effects/woodhit.ogg'

/obj/structure/imported/crate_breakable/Initialize()
	. = ..()
	PopulateContents()

/obj/structure/imported/crate_breakable/proc/PopulateContents()
	// Override this to add items to the crate
	return

/obj/structure/imported/crate_breakable/Destroy()
	// Drop all contents when destroyed
	for(var/atom/movable/AM in contents)
		AM.forceMove(get_turf(src))
	return ..()

/obj/structure/imported/crate_breakable/deconstruct(disassembled = TRUE)
	if(material_drop && material_drop_amount)
		new material_drop(loc, material_drop_amount)
	// Drop contents
	for(var/atom/movable/AM in contents)
		AM.forceMove(get_turf(src))
	qdel(src)

/obj/structure/imported/crate_breakable/attack_hand(mob/user)
	to_chat(user, span_notice("This crate is sealed shut. You'll need to break it open."))
	return ..()

/obj/structure/imported/crate_breakable/attackby(obj/item/W, mob/user, params)
	if(W.force > 0)
		playsound(src, break_sound, 50, TRUE)
	return ..()

